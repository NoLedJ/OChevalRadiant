# ---------------------------------------------------------
# 🔁 SPA Fallback (Angular routing)
# ---------------------------------------------------------
Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
RewriteBase /

# Domaine de production uniquement : ne pas rediriger localhost.
# HTTPS doit refléter le TLS réel ; ne pas faire confiance à un X-Forwarded-Proto arbitraire.
RewriteCond %{HTTP_HOST} ^(?:www\.)?ochevalradiant\.com(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.ochevalradiant\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://ochevalradiant.com%{REQUEST_URI} [R=301,L,NE]

# Le document d'erreur est une ressource terminale, jamais une nouvelle erreur.
# Accès direct : 200 + noindex ; ErrorDocument conserve le 404 de l'URL inconnue.
# Ne pas dépendre de REDIRECT_STATUS pour sortir du traitement d'erreur.
RewriteRule ^404\.html$ - [END]

# Fichiers internes : pas d'URL alternative indexable.
RewriteRule ^_seo(?:/|$) - [R=404,END,NC]
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^(a\-propos|equipe|chevaux|bienfaits|accompagnements|experiences|projets|partenaires|contact|mentions\-legales|politique\-confidentialite|conditions_utilisation)/$ /$1 [R=301,L]

# Routes connues seulement : métadonnées HTTP propres à chaque page.
RewriteRule ^(a\-propos|equipe|chevaux|bienfaits|accompagnements|experiences|projets|partenaires|contact|mentions\-legales|politique\-confidentialite|conditions_utilisation)$ _seo/$1.html [END]
# Pas de fallback ni de R=404 global : le serveur sert les fichiers existants,
# et son 404 natif utilise ErrorDocument pour les URL/ressources absentes.

# ---------------------------------------------------------
# 🗜️ Compression Gzip / Brotli
# ---------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>


# ---------------------------------------------------------
# ⚡ Cache des assets Angular (build /browser)
# ---------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Cache long pour les fichiers fingerprintés
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"

    # HTML → jamais mis en cache
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Empêcher le cache sur index.html (important pour Angular)
<FilesMatch "\.html$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </IfModule>
</FilesMatch>


# ---------------------------------------------------------
# 🔐 Sécurité minimale
# ---------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
