{
  "name": "ocheval-radiant",
  "version": "1.2.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/build.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "test:html": "node --test scripts/generated-html.test.mjs",
    "typecheck": "tsc --project tsconfig.spec.json --noEmit && ngc --project tsconfig.app.json --noEmit"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~22.2.4",
    "@angular/compiler": "~22.2.4",
    "@angular/core": "~22.2.4",
    "@angular/forms": "~22.2.4",
    "@angular/platform-browser": "~22.2.4",
    "@angular/router": "~22.2.4",
    "fslightbox-angular": "^1.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "~22.2.4",
    "@types/jasmine": "~5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}
